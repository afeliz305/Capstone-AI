# Optional owner-only indexing overrides. No AI provider or secret is required.
# .env files are NOT automatically loaded; use PowerShell $env:NAME = 'value'.
# Copy server/website-index/config.json to an owner-controlled config if needed.
CAPSTONE_INDEX_CONFIG=C:/path/to/website-index.config.json
# Must be outside public_html and outside the public asset allowlist.
CAPSTONE_INDEX_DIR=C:/path/to/private/capstone-public-index

# Cloudflare/GitHub build inputs. Use only the public project URL and an
# sb_publishable_ key; never use a service-role/secret key here.
MIRA_SUPABASE_URL=https://your-project-ref.supabase.co
MIRA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
MIRA_PUBLIC_ORIGIN=https://your-reviewed-preview.pages.dev/

# Cloudflare Function-only AI settings. Keep OPENAI_API_KEY in a Cloudflare
# encrypted secret; never put a value in this file, a static build, or Git.
# Live calls require BOTH MIRA_AI_PROVIDER=openai and MIRA_AI_LIVE_ENABLED=true.
MIRA_AI_PROVIDER=mock
MIRA_AI_LIVE_ENABLED=false
MIRA_OPENAI_MODEL=gpt-6-luna
MIRA_AI_MAX_REQUESTS_PER_MINUTE=12
MIRA_AI_MAX_OUTPUT_TOKENS=700
MIRA_AI_TIMEOUT_MS=15000
MIRA_AI_INPUT_USD_PER_MILLION=0
MIRA_AI_OUTPUT_USD_PER_MILLION=0
OPENAI_API_KEY=
