{
  "name": "mira-ai-budget",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "MIRA_AI_BUDGET", "class_name": "AiBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AiBudget"] }],
  "vars": { "MIRA_AI_BUDGET_ENABLED": "true", "MIRA_AI_ALLOW_INITIALIZE": "false" }
}
