{
  "manifest_version": 3,
  "name": "MIRA Portal Connector",
  "version": "0.4.0",
  "description": "Local, read-only access to the signed-in FIU Capstone dashboard for MIRA.",
  "permissions": ["alarms", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:3005/*"],
  "optional_host_permissions": ["https://capstone.cs.fiu.edu/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "MIRA Portal Connector", "default_popup": "popup.html"},
  "minimum_chrome_version": "116"
}
